POSTGRES_DB=volteras
POSTGRES_USER=volteras
POSTGRES_PASSWORD=volteras

# Compose services reach PostgreSQL through its service name, `db`.
DATABASE_URL=postgresql+psycopg://volteras:volteras@db:5432/volteras

VITE_API_BASE_URL=http://localhost:8000

# Local Grafana login (replace these defaults outside development).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
