POSTGRES_DB=volteras
POSTGRES_USER=volteras
POSTGRES_PASSWORD=volteras
POSTGRES_ADMIN_PASSWORD=postgres
REPMGR_PASSWORD=repmgr
PGPOOL_ADMIN_USERNAME=admin
PGPOOL_ADMIN_PASSWORD=admin

# Compose clients use Pgpool; it routes writes to the primary and balances reads.
DATABASE_URL=postgresql+psycopg://volteras:volteras@database_load_balancer:5432/volteras

VITE_API_BASE_URL=http://localhost:8000

# Local Grafana login (replace these defaults outside development).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
